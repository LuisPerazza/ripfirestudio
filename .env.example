OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
GOOGLE_CLIENT_ID=
# Endereço do servidor. Deixe assim também na VPS: o nginx repassa o público pra cá.
HOST=127.0.0.1
PORT=8787
# Mercado Pago: Access Token em "Suas integrações > Credenciais". Use a de
# teste (TEST-...) até tudo funcionar; depois troque pela de produção.
MERCADOPAGO_ACCESS_TOKEN=
# Endereço público do site, com https (ex.: https://seusite.com.br). Sem ele,
# ou no PC, o Mercado Pago não volta pro site nem avisa o pagamento sozinho:
# o cliente confere em Minha conta > "Já paguei, verificar".
SITE_URL=
# Métricas e anúncios (opcionais). Vazio = desligado. Mesmo configurados, só
# carregam no navegador de quem aceitar no aviso de cookies.
# Google Analytics 4: "ID da métrica" do fluxo da Web (G-XXXXXXXXXX).
GA4_MEASUREMENT_ID=
# Pixel da Meta (Facebook/Instagram): só os números do ID do pixel.
META_PIXEL_ID=
# Compra enviada pelo servidor quando o pagamento é aprovado (conta até quem
# pagou e fechou a aba). Só pra quem aceitou a categoria no aviso de cookies.
# GA4: Admin > Fluxos de dados > seu fluxo > "Chaves secretas da API do Measurement Protocol".
GA4_API_SECRET=
# Meta: Gerenciador de Eventos > seu pixel > Configurações > API de Conversões > "Gerar token de acesso".
META_CAPI_TOKEN=
META_GRAPH_VERSION=v25.0
# Google Tag Manager (opcional): GTM-XXXXXXX. Carrega só pra quem aceitou
# Estatística ou Marketing e recebe o Consent Mode v2. Use o GTM OU os IDs
# diretos acima (GA4/Pixel), não os dois, senão os eventos contam dobrado.
# Tag nova que não seja do Google (HTML personalizado): em "Configurações de
# consentimento" da tag, exija ad_storage ou analytics_storage.
GTM_CONTAINER_ID=
